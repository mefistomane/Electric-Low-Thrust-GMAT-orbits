OrbitView1_View.DefaultUp = [ 0 0 1 ];
OrbitView1_View.SetCurrentLocation = Off;
OrbitView1_View.FOVy = 45;

%--------------------------------------------------------------------------
% Mission Sequence - Disposal Finale Mare Nubium
%--------------------------------------------------------------------------


BeginMissionSequence;
Toggle DefaultGroundTrackPlot Off;
% 1. ATTESA
Propagate DefaultProp(LRS1) {LRS1.ElapsedDays = 1};

% 2. BURN RADIALE BREVE per modificare AOP
PreBurnMass = LRS1.TotalMass;
BeginFiniteBurn RadialBurn(LRS1);
Propagate DefaultProp(LRS1) {LRS1.ElectricTank1.FuelMass = 0.20, StopTolerance = 0.001};
EndFiniteBurn RadialBurn(LRS1);

% 3. DISCESA A 150 KM
Propagate DefaultProp(LRS1) {LRS1.Luna.Altitude = 150};

PreBurnMass = LRS1.TotalMass;
Toggle DefaultGroundTrackPlot On;
% 4. BURN DISPOSAL
BeginFiniteBurn RetrogradeBurn(LRS1);
Propagate DefaultProp(LRS1) {LRS1.ElectricTank1.FuelMass = 0.01, StopTolerance = 0.001};
EndFiniteBurn RetrogradeBurn(LRS1);

DeltaV = DeltaV + (800 * 9.81 * log(PreBurnMass / LRS1.TotalMass));

% 5. IMPATTO
Propagate DefaultProp(LRS1) {LRS1.Luna.Altitude = 0, StopTolerance = 0.001};

Write LRS1.Luna.Latitude { Style = Concise, LogFile = false, MessageWindow = true }
Write LRS1.Luna.Longitude { Style = Concise, LogFile = false, MessageWindow = true }
Write LRS1.Luna.Altitude { Style = Concise, LogFile = false, MessageWindow = true }
Write LRS1.ElectricTank1.FuelMass { Style = Concise, LogFile = false, MessageWindow = true }
Write LRS1.LunaMJ2000Eq.AOP { Style = Concise, LogFile = false, MessageWindow = true }
