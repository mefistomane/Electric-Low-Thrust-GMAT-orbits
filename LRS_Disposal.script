%---------- Arrays, Variables, Strings
%----------------------------------------
Create Variable DeltaV PreBurnMass BurnDuration AOP_Burn_Duration ImpactLat ImpactLon ImpactDay CoastToTarget AltThreshold;
DeltaV = 0;
PreBurnMass = 0;
BurnDuration = 0;
AOP_Burn_Duration = 0;
ImpactLat = 0;
ImpactLon = 0;
ImpactDay = 0;
CoastToTarget = 22800;
AltThreshold = 2;









%----------------------------------------
%---------- User Objects
%----------------------------------------

Create OpenFramesView DefaultOrbitView_View;
DefaultOrbitView_View.ViewFrame = CoordinateSystem;
DefaultOrbitView_View.ViewTrajectory = Off;
DefaultOrbitView_View.InertialFrame = Off;
DefaultOrbitView_View.SetDefaultLocation = On;
DefaultOrbitView_View.DefaultEye = [ 30000 0 0 ];
DefaultOrbitView_View.DefaultCenter = [ 0 0 0 ];
DefaultOrbitView_View.DefaultUp = [ 0 0 1 ];
DefaultOrbitView_View.SetCurrentLocation = Off;
DefaultOrbitView_View.FOVy = 45;

Create OpenFramesView OrbitView1_View;
OrbitView1_View.ViewFrame = CoordinateSystem;
OrbitView1_View.ViewTrajectory = Off;
OrbitView1_View.InertialFrame = Off;
OrbitView1_View.SetDefaultLocation = On;
OrbitView1_View.DefaultEye = [ 30000 0 0 ];
