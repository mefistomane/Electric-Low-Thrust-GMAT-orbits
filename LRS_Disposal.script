%----------------------------------------
%---------- ForceModels
%----------------------------------------

Create ForceModel DefaultProp_ForceModel;
DefaultProp_ForceModel.CentralBody = Luna;
DefaultProp_ForceModel.PrimaryBodies = {Luna};
DefaultProp_ForceModel.PointMasses = {Earth, Sun};
DefaultProp_ForceModel.Drag = None;
DefaultProp_ForceModel.SRP = Off;
DefaultProp_ForceModel.RelativisticCorrection = Off;
DefaultProp_ForceModel.ErrorControl = RSSStep;
DefaultProp_ForceModel.GravityField.Luna.Degree = 8;
DefaultProp_ForceModel.GravityField.Luna.Order = 8;
DefaultProp_ForceModel.GravityField.Luna.StmLimit = 100;
DefaultProp_ForceModel.GravityField.Luna.PotentialFile = 'LP165P.cof';
DefaultProp_ForceModel.GravityField.Luna.TideModel = 'None';

%----------------------------------------
%---------- Propagators
%----------------------------------------

Create Propagator DefaultProp;
DefaultProp.FM = DefaultProp_ForceModel;
DefaultProp.Type = RungeKutta89;
DefaultProp.InitialStepSize = 60;
DefaultProp.Accuracy = 9.999999999999999e-09;
DefaultProp.MinStep = 0.001;
DefaultProp.MaxStep = 2700;
DefaultProp.MaxStepAttempts = 50;
DefaultProp.StopIfAccuracyIsViolated = true;


%----------------------------------------
%---------- Burns
%----------------------------------------

Create FiniteBurn RetrogradeBurn;
RetrogradeBurn.Thrusters = {ElectricThruster1};
RetrogradeBurn.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

Create FiniteBurn RadialBurn;
RadialBurn.Thrusters = {ThrusterRadial};
RadialBurn.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

%----------------------------------------
%---------- Coordinate Systems aggiuntivi
%----------------------------------------

Create CoordinateSystem LunaMJ2000Eq;
LunaMJ2000Eq.Origin = Luna;
LunaMJ2000Eq.Axes = MJ2000Eq;

Create CoordinateSystem LunaFixed;
LunaFixed.Origin = Luna;
LunaFixed.Axes = BodyFixed;

%----------------------------------------
%---------- Solvers
%----------------------------------------

% --- Solvers ---
Create DifferentialCorrector DC;
DC.ShowProgress = true;
DC.ReportStyle = Normal;
DC.ReportFile = 'DifferentialCorrectorDC.data';
DC.MaximumIterations = 50;
DC.DerivativeMethod = ForwardDifference;
DC.Algorithm = NewtonRaphson;


%----------------------------------------
%---------- Report
%----------------------------------------

Create ReportFile DispReport;
DispReport.SolverIterations = Current;
DispReport.UpperLeft = [ 0.1088235294117647 0.03369434416365824 ];
DispReport.Size = [ 0.5982352941176471 0.7954271961492179 ];
DispReport.RelativeZOrder = 33;
DispReport.Maximized = false;
DispReport.Filename = 'Disposal_Report.txt';
DispReport.Precision = 10;
DispReport.Add = {LRS1.ElapsedDays, LRS1.Luna.Altitude, LRS1.Luna.Latitude, LRS1.Luna.Longitude, LRS1.Luna.RadPer, LRS1.Luna.RadApo, LRS1.LunaMJ2000Eq.AOP, LRS1.ElectricTank1.FuelMass, DeltaV};
DispReport.WriteHeaders = true;
DispReport.LeftJustify = On;
DispReport.ZeroFill = Off;
DispReport.FixedWidth = true;
DispReport.Delimiter = ' ';
DispReport.ColumnWidth = 23;
DispReport.WriteReport = true;
DispReport.AppendToExistingFile = false;

