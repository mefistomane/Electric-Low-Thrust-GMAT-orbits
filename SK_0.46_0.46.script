%----------------------------------------
%---------- Propagators
%----------------------------------------

Create Propagator DefaultProp;
DefaultProp.FM = DefaultProp_ForceModel;
DefaultProp.Type = RungeKutta89;
DefaultProp.InitialStepSize = 60;
DefaultProp.Accuracy = 9.999999999999999e-09;
DefaultProp.MinStep = 0.001;
DefaultProp.MaxStep = 2700;
DefaultProp.MaxStepAttempts = 100;
DefaultProp.StopIfAccuracyIsViolated = true;

%----------------------------------------
%---------- Burns
%----------------------------------------

Create FiniteBurn ProgradeBurn;
ProgradeBurn.Thrusters = {ThrusterPrograde};
ProgradeBurn.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

Create FiniteBurn RetrogradeBurn;
RetrogradeBurn.Thrusters = {ThrusterRetrograde};
RetrogradeBurn.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

Create FiniteBurn RadialBurn;
RadialBurn.Thrusters = {ThrusterRadial};
RadialBurn.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

