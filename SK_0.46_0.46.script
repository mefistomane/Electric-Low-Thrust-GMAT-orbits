SK_Report.WriteHeaders = true;
SK_Report.LeftJustify = On;
SK_Report.ZeroFill = Off;
SK_Report.FixedWidth = true;
SK_Report.Delimiter = ' ';
SK_Report.ColumnWidth = 23;
SK_Report.WriteReport = true;
SK_Report.AppendToExistingFile = false;

