%----------------------------------------
%---------- Arrays, Variables, Strings
%----------------------------------------


%----------------------------------------
%---------- Variables
%----------------------------------------

Create Variable DeltaV FuelConsumed PreBurnMass BurnCount MoonRad SMA_Target ECC_Target SMA_Tol ECC_Tol SMA_Upper;
Create Variable SMA_Lower ECC_Upper ECC_Lower BurnDuration_Apo BurnDuration_Per HalfBurn_Apo HalfBurn_Per CoastApo CoastPer BF_Apo;
Create Variable BF_Per TotalBurnTime;
TotalBurnTime = 0
DeltaV = 0;
FuelConsumed = 0;
PreBurnMass = 0;
BurnCount = 0;
MoonRad = 1737.4;
SMA_Target = 3785.489;
ECC_Target = 0.5158587;
SMA_Tol = 100;
ECC_Tol = 0.008;
SMA_Upper = 0;
SMA_Lower = 0;
ECC_Upper = 0;
ECC_Lower = 0;
BF_Apo = 0.46;
BF_Per = 0.46;




%----------------------------------------
%---------- User Objects
%----------------------------------------

Create OpenFramesView OrbitView1_View;
OrbitView1_View.ViewFrame = CoordinateSystem;
OrbitView1_View.ViewTrajectory = Off;
OrbitView1_View.InertialFrame = Off;
OrbitView1_View.SetDefaultLocation = On;
OrbitView1_View.DefaultEye = [ 20000 0 5000 ];
OrbitView1_View.DefaultCenter = [ 0 0 0 ];
OrbitView1_View.DefaultUp = [ 0 0 1 ];
OrbitView1_View.SetCurrentLocation = Off;
OrbitView1_View.FOVy = 45;


%----------------------------------------
%---------- Mission Sequence
%----------------------------------------


BeginMissionSequence;

SMA_Upper = SMA_Target + SMA_Tol;
SMA_Lower = SMA_Target - SMA_Tol;
ECC_Upper = ECC_Target + ECC_Tol;
ECC_Lower = ECC_Target - ECC_Tol;

Propagate DefaultProp(LRS1) {LRS1.Luna.Apoapsis};

While LRS1.ElapsedDays < 548 & LRS1.ElectricTank1.FuelMass > 0.01
   
   Report SK_Report LRS1.ElapsedDays LRS1.Luna.SMA LRS1.Luna.ECC LRS1.Luna.RadApo LRS1.Luna.RadPer BurnCount DeltaV FuelConsumed;
   
   % ================================================
   % CONTROLLO SMA - burn centrato SULL'APOAPSIS
   % Siamo all'apoapsis: coast = T/2 - BF*T/2
   % ================================================
   
   % CASO 1: SMA troppo grande - retrograde centrato all'apoapsis
   If LRS1.Luna.SMA > SMA_Upper
      BurnDuration_Apo = BF_Apo * LRS1.Luna.OrbitPeriod;
      HalfBurn_Apo = BurnDuration_Apo / 2;
      CoastApo = LRS1.Luna.OrbitPeriod / 2 - HalfBurn_Apo;
      Propagate DefaultProp(LRS1) {LRS1.ElapsedSecs = CoastApo};
      PreBurnMass = LRS1.TotalMass;
      BeginFiniteBurn RetrogradeBurn(LRS1);
      Propagate DefaultProp(LRS1) {LRS1.ElapsedSecs = BurnDuration_Apo};
      EndFiniteBurn RetrogradeBurn(LRS1);
		TotalBurnTime = TotalBurnTime + BurnDuration;
      DeltaV = DeltaV + (800 * 9.81 * log(PreBurnMass / LRS1.TotalMass));
      FuelConsumed = FuelConsumed + (PreBurnMass - LRS1.TotalMass);
      BurnCount = BurnCount + 1;
      Propagate DefaultProp(LRS1) {LRS1.Luna.Apoapsis};
   EndIf;
   
   % CASO 2: SMA troppo piccolo - prograde centrato all'apoapsis
   If LRS1.Luna.SMA < SMA_Lower
      BurnDuration_Apo = BF_Apo * LRS1.Luna.OrbitPeriod;
      HalfBurn_Apo = BurnDuration_Apo / 2;
      CoastApo = LRS1.Luna.OrbitPeriod / 2 - HalfBurn_Apo;
      Propagate DefaultProp(LRS1) {LRS1.ElapsedSecs = CoastApo};
      PreBurnMass = LRS1.TotalMass;
      BeginFiniteBurn ProgradeBurn(LRS1);
      Propagate DefaultProp(LRS1) {LRS1.ElapsedSecs = BurnDuration_Apo};
      EndFiniteBurn ProgradeBurn(LRS1);
		TotalBurnTime = TotalBurnTime + BurnDuration;
      DeltaV = DeltaV + (800 * 9.81 * log(PreBurnMass / LRS1.TotalMass));
      FuelConsumed = FuelConsumed + (PreBurnMass - LRS1.TotalMass);
      BurnCount = BurnCount + 1;
      Propagate DefaultProp(LRS1) {LRS1.Luna.Apoapsis};
   EndIf;
   
   % ================================================
   % PROPAGA AL PERIAPSIS
   % ================================================
   Propagate DefaultProp(LRS1) {LRS1.Luna.Periapsis};
   
   % ================================================
   % CONTROLLO ECC - burn centrato SUL PERIAPSIS
   % Siamo al periapsis: coast = T/2 - BF*T/2
   % ================================================
   
   % CASO 3: ECC troppo grande - prograde centrato al periapsis
   If LRS1.Luna.ECC > ECC_Upper
      BurnDuration_Per = BF_Per * LRS1.Luna.OrbitPeriod;
      HalfBurn_Per = BurnDuration_Per / 2;
      CoastPer = LRS1.Luna.OrbitPeriod / 2 - HalfBurn_Per;
      Propagate DefaultProp(LRS1) {LRS1.ElapsedSecs = CoastPer};
      PreBurnMass = LRS1.TotalMass;
      BeginFiniteBurn ProgradeBurn(LRS1);
      Propagate DefaultProp(LRS1) {LRS1.ElapsedSecs = BurnDuration_Per};
      EndFiniteBurn ProgradeBurn(LRS1);
      DeltaV = DeltaV + (800 * 9.81 * log(PreBurnMass / LRS1.TotalMass));
		TotalBurnTime = TotalBurnTime + BurnDuration;
      FuelConsumed = FuelConsumed + (PreBurnMass - LRS1.TotalMass);
      BurnCount = BurnCount + 1;
      Propagate DefaultProp(LRS1) {LRS1.Luna.Periapsis};
   EndIf;
   
   % CASO 4: ECC troppo piccola - retrograde centrato al periapsis
   If LRS1.Luna.ECC < ECC_Lower
      BurnDuration_Per = BF_Per * LRS1.Luna.OrbitPeriod;
      HalfBurn_Per = BurnDuration_Per / 2;
      CoastPer = LRS1.Luna.OrbitPeriod / 2 - HalfBurn_Per;
      Propagate DefaultProp(LRS1) {LRS1.ElapsedSecs = CoastPer};
      PreBurnMass = LRS1.TotalMass;
      BeginFiniteBurn RetrogradeBurn(LRS1);
      Propagate DefaultProp(LRS1) {LRS1.ElapsedSecs = BurnDuration_Per};
      EndFiniteBurn RetrogradeBurn(LRS1);
		TotalBurnTime = TotalBurnTime + BurnDuration;
      DeltaV = DeltaV + (800 * 9.81 * log(PreBurnMass / LRS1.TotalMass));
      FuelConsumed = FuelConsumed + (PreBurnMass - LRS1.TotalMass);
      BurnCount = BurnCount + 1;
      Propagate DefaultProp(LRS1) {LRS1.Luna.Periapsis};
   EndIf;
   
   Propagate DefaultProp(LRS1) {LRS1.Luna.Apoapsis};

EndWhile;
