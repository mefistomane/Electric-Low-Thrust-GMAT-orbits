%----------------------------------------
%---------- Arrays, Variables, Strings
%----------------------------------------
Create Variable BurnDuration PreBurnMass DeltaV CurrentRadPer CurrentRadApo TargetRadPer TargetRadApo ThresholdRadPer ThresholdRadApo OrbitCount;
Create Variable TargetINC ThresholdINC MaxIterations BurnFraction TransferStartEpoch TransferEndEpoch TransferTime SafetyAlt SafetyFlag BurnTime;
Create Variable TotalBurnTime OrbitPeriodHours AltApo AltPer FuelConsumed HalfBurn CoastToIgnition InitialFuel CurrentINC BF1;
Create Variable BF2 Phase1Active Phase2Active;
BurnDuration = 86400;      % secondi di burn per ogni manovra (regolabile)
PreBurnMass = 0;
DeltaV = 0;
TargetRadPer = 1857.4;   % 100 km altitudine
TargetRadApo = 5000.4;   % 4000 km altitudine
ThresholdRadPer = 1838.4;   % TargetRadPer + 1
ThresholdRadApo = 5738.4;   % TargetRadApo + 1
OrbitCount = 0;
TargetINC = 86;
ThresholdINC = 86.5;  % tolleranza 0.5 gradi
MaxIterations = 15000;
BurnFraction = 1;
SafetyAlt = 1842.4;
SafetyFlag = 1;
OrbitPeriodHours = 0;
AltApo = 0;
AltPer = 0;
FuelConsumed = 0;
HalfBurn = 0;
CoastToIgnition = 0;
BF1 = 0.367;
BF2 = 0.411;







%----------------------------------------
%---------- User Objects (Telecamera)
%----------------------------------------

Create OpenFramesView DefaultOrbitView_View;
DefaultOrbitView_View.ViewFrame = Luna;
DefaultOrbitView_View.ViewTrajectory = Off;
DefaultOrbitView_View.InertialFrame = Off;
DefaultOrbitView_View.SetDefaultLocation = On;
DefaultOrbitView_View.DefaultEye = [ 20000 0 5000 ];
DefaultOrbitView_View.DefaultCenter = [ 0 0 0 ];
DefaultOrbitView_View.DefaultUp = [ 0 0 1 ];
DefaultOrbitView_View.SetCurrentLocation = On;
DefaultOrbitView_View.CurrentEye = [ -7893.245696538844 -17599.50951544834 7276.945594802403 ];
DefaultOrbitView_View.CurrentCenter = [ 3.637978807091713e-12 3.637978807091713e-12 -5.456968210637569e-12 ];
DefaultOrbitView_View.CurrentUp = [ -0.5400370318654137 0.5168516656624682 0.6642472129530739 ];
DefaultOrbitView_View.FOVy = 45;




%----------------------------------------
%---------- User Objects
%----------------------------------------

Create OpenFramesView LunaView;
LunaView.ViewFrame = CoordinateSystem;
LunaView.ViewTrajectory = On;
LunaView.InertialFrame = On;
LunaView.LookAtFrame = CoordinateSystem;
LunaView.ShortestAngle = Off;
LunaView.SetDefaultLocation = Off;
LunaView.SetCurrentLocation = On;
LunaView.CurrentEye = [ -285.4442017836359 -200002.2628657295 29.60219660088558 ];
LunaView.CurrentCenter = [ 0 0 1.857358711276902e-11 ];
LunaView.CurrentUp = [ 0.0002611460790332228 0.0001476365927650658 0.9999999550030799 ];
LunaView.FOVy = 45;

%----------------------------------------
%---------- Mission Sequence
%----------------------------------------



% ========================================================
% ----------------- MISSION SEQUENCE ---------------------
% ========================================================
BeginMissionSequence;

% Inizializzazione
DeltaV = 0;
OrbitCount = 0;
TransferStartEpoch = LRS1.A1ModJulian;
InitialFuel = LRS1.ElectricTank1.FuelMass;
Phase1Active = 1;
Phase2Active = 1;
SafetyAlt = 1852.4;

Propagate DefaultProp(LRS1) {LRS1.Luna.Apoapsis};
AltApo = LRS1.Luna.RadApo - 1737.4;
AltPer = LRS1.Luna.RadPer - 1737.4;
CurrentINC = LRS1.LunaMJ2000Eq.INC;
% ========================================================
% FASE 1: Abbassa RadApo
% ========================================================
While LRS1.Luna.RadApo > ThresholdRadApo & Phase1Active == 1
   If LRS1.Luna.RadPer < SafetyAlt
      Phase1Active = 0;
   EndIf;
   
   If Phase1Active == 1
      PreBurnMass = LRS1.TotalMass;
      BurnDuration = BF1 * LRS1.Luna.OrbitPeriod;
      HalfBurn = BurnDuration / 2;
      CoastToIgnition = LRS1.Luna.OrbitPeriod / 2 - HalfBurn;
      
      Propagate DefaultProp(LRS1) {LRS1.ElapsedSecs = CoastToIgnition};
      
      BeginFiniteBurn FiniteBurn1(LRS1);
      Propagate DefaultProp(LRS1) {LRS1.ElapsedSecs = BurnDuration};
      EndFiniteBurn FiniteBurn1(LRS1);
      TotalBurnTime = TotalBurnTime + BurnDuration;
      Propagate DefaultProp(LRS1) {LRS1.Luna.Apoapsis};
      
      % AGGIORNAMENTO VARIABILI PER I GRAFICI
      AltApo = LRS1.Luna.RadApo - 1737.4;
      AltPer = LRS1.Luna.RadPer - 1737.4;
      CurrentINC = LRS1.LunaMJ2000Eq.INC;
      OrbitCount = OrbitCount + 1;
      DeltaV = DeltaV + (800 * 9.81 * log(PreBurnMass / LRS1.TotalMass));
   EndIf;
EndWhile;

% ========================================================
% FASE 2: Abbassa RadPer
% ========================================================
Propagate DefaultProp(LRS1) {LRS1.Luna.Periapsis};

While LRS1.Luna.RadPer > ThresholdRadPer & Phase2Active == 1
   If LRS1.Luna.RadPer < 1838.4
      Phase2Active = 0;
   EndIf;
   
   If Phase2Active == 1
      PreBurnMass = LRS1.TotalMass;
      BurnDuration = BF2 * LRS1.Luna.OrbitPeriod;
      HalfBurn = BurnDuration / 2;
      CoastToIgnition = LRS1.Luna.OrbitPeriod / 2 - HalfBurn;
      
      Propagate DefaultProp(LRS1) {LRS1.ElapsedSecs = CoastToIgnition};
      
      BeginFiniteBurn FiniteBurn1(LRS1);
      Propagate DefaultProp(LRS1) {LRS1.ElapsedSecs = BurnDuration};
      EndFiniteBurn FiniteBurn1(LRS1);
      TotalBurnTime = TotalBurnTime + BurnDuration;
      Propagate DefaultProp(LRS1) {LRS1.Luna.Periapsis};
      
      % AGGIORNAMENTO VARIABILI PER I GRAFICI
      AltApo = LRS1.Luna.RadApo - 1737.4;
      AltPer = LRS1.Luna.RadPer - 1737.4;
      CurrentINC = LRS1.LunaMJ2000Eq.INC;
      OrbitCount = OrbitCount + 1;
      DeltaV = DeltaV + (800 * 9.81 * log(PreBurnMass / LRS1.TotalMass));
      FuelConsumed = 2 - LRS1.ElectricTank1.FuelMass;
   EndIf;
EndWhile;
Write TotalBurnTime { Style = Concise, LogFile = false, MessageWindow = true }